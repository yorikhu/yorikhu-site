# API Dockerfile - Build on Linux
FROM node:20-alpine AS builder

RUN npm install -g pnpm@9

WORKDIR /app

# 复制整个 monorepo
COPY package.json pnpm-lock.yaml .npmrc ./
COPY packages packages/
COPY apps/api apps/api/

# 安装所有依赖
RUN pnpm install --frozen-lockfile --shamefully-hoist

# 调试：查看 node_modules 结构
RUN echo "=== Root node_modules ===" && ls -la /app/node_modules/ | head -10
RUN echo "=== API node_modules ===" && ls -la /app/apps/api/node_modules/ | head -10
RUN echo "=== Find nest ===" && find /app/apps/api/node_modules -name "nest" -o -name "@nestjs" | head -10

# 构建
WORKDIR /app/apps/api
RUN pnpm build

# 清理开发依赖
RUN pnpm prune --prod
RUN rm -rf node_modules/.cache

# ========== Production ==========
FROM node:20-alpine

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

COPY --from=builder --chown=nodejs:nodejs /app/apps/api/node_modules ./node_modules/
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/dist ./dist/
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/package.json ./

USER nodejs

EXPOSE 5000

ENV NODE_ENV=production

CMD ["node", "dist/main.js"]
