# API Dockerfile - Build on Linux
FROM node:20-alpine AS builder

RUN npm install -g pnpm@9

WORKDIR /app

# 复制整个 monorepo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages packages/
COPY apps/api apps/api/

# 根目录安装（workspace 依赖）
RUN pnpm install --frozen-lockfile

# 子目录再安装一次（确保 CLI 工具在本地）
WORKDIR /app/apps/api
RUN pnpm install --frozen-lockfile --shamefully-hoist

# 调试
RUN ls node_modules/ | grep nest

# 构建
RUN pnpm build

# 清理开发依赖
RUN pnpm prune --prod
RUN rm -rf node_modules/.cache

# ========== Production ==========
FROM node:20-alpine

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

COPY --from=builder --chown=nodejs:nodejs /app/apps/api/node_modules ./node_modules/
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/dist ./dist/
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/package.json ./

USER nodejs

EXPOSE 5000

ENV NODE_ENV=production

CMD ["node", "dist/main.js"]
