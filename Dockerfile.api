# API Dockerfile - pnpm official monorepo approach
FROM node:20-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# corepack 会读取 package.json 中的 packageManager 字段
RUN corepack enable
RUN corepack prepare pnpm@10.4.0 --activate

FROM base AS build
WORKDIR /app

# 1. 先复制依赖定义文件（利用层缓存）
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# 2. 安装依赖（只有依赖变化时才重新运行）
RUN pnpm install --frozen-lockfile --shamefully-hoist

# 3. 再复制源代码（代码变化不影响依赖安装层）
COPY packages packages/
COPY apps/api apps/api/

# 4. 构建
RUN cd apps/api && pnpm run build

# pnpm deploy 创建自包含的生产目录（只包含 node_modules）
RUN pnpm deploy --filter=api --prod --legacy /prod/api

FROM base AS prod
# 复制生产依赖
COPY --from=build /prod/api /prod/api
# 复制构建产物
COPY --from=build /app/apps/api/dist /prod/api/dist
WORKDIR /prod/api

EXPOSE 5000

ENV NODE_ENV=production

CMD ["node", "dist/main.js"]
