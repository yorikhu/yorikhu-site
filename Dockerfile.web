# Web Dockerfile - Build on Linux
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy entire project structure (needed for tsconfig references)
COPY packages ./packages
COPY apps/web ./apps/web
COPY package.json pnpm-lock.yaml ./

# Build Web
WORKDIR /app/apps/web
RUN pnpm install
RUN pnpm build

# Prepare production bundle - combine standalone + static assets
RUN cp -r /app/dist/web/.next/static /app/dist/web/standalone/.next/ 2>/dev/null || true

# Production image
FROM node:20-alpine

WORKDIR /app

# Copy the prepared standalone bundle (already contains static assets)
COPY --from=builder /app/dist/web/standalone ./

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

CMD ["node", "server.js"]
