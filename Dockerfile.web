# Web Dockerfile - Build on Linux
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy entire project structure (needed for tsconfig references)
COPY packages ./packages
COPY apps/web ./apps/web
COPY package.json pnpm-lock.yaml ./

# Build Web
WORKDIR /app/apps/web
RUN pnpm install
RUN pnpm build

# Production image
FROM node:20-alpine

WORKDIR /app

# Copy standalone server and dependencies from dist output
COPY --from=builder /app/dist/web/standalone ./
COPY --from=builder /app/dist/web/.next/static ./.next/static/

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

CMD ["node", "server.js"]
