# Web Dockerfile - pnpm official monorepo approach
FROM node:20-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# corepack 会读取 package.json 中的 packageManager 字段
RUN corepack enable
RUN corepack prepare pnpm@10.4.0 --activate

FROM base AS build
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages packages/
COPY apps/web apps/web/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm --filter web build

# pnpm deploy 创建自包含的生产目录
RUN pnpm deploy --filter=web --prod --legacy /prod/web

FROM base AS prod
COPY --from=build /prod/web /prod/web
WORKDIR /prod/web

EXPOSE 3000

ENV NODE_ENV=production

CMD ["pnpm", "start"]
