# Web Dockerfile - Build on Linux
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy entire project structure (needed for tsconfig references)
COPY packages ./packages
COPY apps/web ./apps/web
COPY package.json pnpm-lock.yaml ./

# Build Web (dist will be in /app/dist/web)
WORKDIR /app/apps/web
RUN pnpm install
RUN pnpm build

# Production image
FROM node:20-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY apps/web/package.json ./
COPY package.json pnpm-lock.yaml ./

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile

# Copy built files from builder (dist is at /app/dist/web)
COPY --from=builder /app/dist/web ./dist/

EXPOSE 3000

ENV NODE_ENV=production

CMD ["npx", "next", "start"]
